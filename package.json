{
  "name": "industrial-training-certificate-management-system",
  "version": "1.0.0",
  "description": "Production-ready 45 Days Industrial Training Certificate Management & Verification System",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/src/server.js",
    "server": "cd backend && node src/server.js",
    "client": "cd frontend && node ./node_modules/vite/bin/vite.js",
    "seed": "cd backend && node src/scripts/seedAdmin.js",
    "seed:demo": "cd backend && node src/scripts/seedDemoData.js",
    "test": "cd backend && node --test tests/*.test.js",
    "build": "cd frontend && npm install --include=dev && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.15.0",
    "postcss": "^8.4.39",
    "qrcode": "^1.5.3",
    "serverless-http": "^4.0.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.3",
    "zod": "^3.23.8"
  },
  "keywords": [
    "certificate",
    "verification",
    "industrial-training",
    "qr-code",
    "pdfkit",
    "mongodb",
    "react",
    "vite"
  ],
  "author": "Nexora Innovations",
  "license": "ISC"
}
